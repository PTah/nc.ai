root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.psm1]
charset = utf-8-bom
end_of_line = crlf

[*.sh]
charset = utf-8
end_of_line = lf

[*-allowed]
charset = utf-8
end_of_line = lf

[*.conf]
charset = utf-8
end_of_line = lf

[*.cfg]
charset = utf-8
end_of_line = lf

[*.md]
end_of_line = lf
